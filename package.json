{
  "name": "project-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @project/sample dev",
    "build": "pnpm --filter @project/sample build",
    "init": "bash scripts/init.sh",
    "harness:check": "node scripts/harness/check.mjs",
    "harness:test": "vitest run --config vitest.harness.config.ts",
    "test:loop": "vitest run --config vitest.loop.config.ts",
    "test:unit": "vitest run --config vitest.loop.config.ts tests/unit",
    "test:property": "vitest run --config vitest.loop.config.ts tests/property",
    "test:e2e": "playwright test",
    "check:quick": "bash scripts/check-quick",
    "check:full": "bash scripts/check-full",
    "ci:quick": "bash scripts/check-quick",
    "ci:local": "SKIP_E2E=1 bash scripts/check-full",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.55.0",
    "fast-check": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,css,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
