#!/usr/bin/env bash
# Lint + types + harness + unit/property. Alvo: < 2 min. Sem DB, sem E2E.
# CI e pre-push chamam este arquivo — não um segundo conjunto de comandos.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
# O hook pre-push exporta GIT_DIR e afins; os testes que criam repositório temporário herdavam isso e gravavam
# no repositório real (23/10/2026: core.bare=true e user.name de teste). O git acha o repositório pela pasta.
unset $(git rev-parse --local-env-vars)
# insteadOf global (token na URL) faz `git remote get-url` reescrever origin nos
# repositórios descartáveis e quebra o contrato de publicação.
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null

echo "== harness:check"
pnpm harness:check

echo "== lint"
pnpm lint

echo "== typecheck"
pnpm typecheck

echo "== harness:test"
pnpm harness:test

echo "== test:loop (unit + property)"
pnpm test:loop

echo "check-quick ok"
